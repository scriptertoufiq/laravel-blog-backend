includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Every model in this application declares its casts through the `casts()`
    # method rather than a `$casts` property, which larastan only reads when it
    # is asked to parse the method body.
    parseModelCastsMethod: true
