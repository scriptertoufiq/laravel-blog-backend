    {
      "name": "Session",
      "item": [
        {
          "name": "Logout  (run last \u2014 clears {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "logout"
              ]
            },
            "description": "Requires a token. Revokes **only the token used for this request** \u2014 other devices stay signed in.\n\n**200** `{ message }`; reusing the token afterwards returns `401`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setVar = (k, v) => { pm.collectionVariables.set(k, v); try { pm.environment.set(k, v); } catch (e) {} };",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "setVar('token', '');"
                ]
              }
            }
          ]
        }
      ],
      "description": "Kept last so a top-to-bottom run stays authenticated throughout."
    }
