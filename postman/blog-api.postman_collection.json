            },
            "description": "Requires a token. **Comment author only** \u2014 not even the post's author may edit someone else's words (`403`).\n\nSets `edited: true`.\n\n**200** `{ message, data }`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"An edited comment from Postman.\"\n}"
            }
          }
        },
        {
          "name": "Delete comment",
          "request": {
            "method": "DELETE",
            "header": [
