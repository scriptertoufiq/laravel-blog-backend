                },
                {
                  "key": "per_page",
                  "value": "20",
                  "description": "1-50, default 20"
                }
              ]
            },
            "description": "Public, newest first, **not cached** (comments turn over too fast).\n\nEach comment carries `can: { update, delete }` telling *you* what you may do, so a UI never renders a button that would 403. Send a token for meaningful values \u2014 without one both are `false`.\n\n**200** `{ data, links, meta }`.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setVar = (k, v) => { pm.collectionVariables.set(k, v); try { pm.environment.set(k, v); } catch (e) {} };",
                  "const b = pm.response.json();",
                  "if (b.data && b.data.length) { setVar('comment_id', b.data[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create comment  \u2192 captures {{comment_id}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/posts/{{post_slug}}/comments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "{{post_slug}}",
                "comments"
              ]
            },
            "description": "Requires a token. `body` 2-2000 chars, trimmed.\n\nQueues an email to the post's author (skipped when commenting on your own post):\n```bash\nphp artisan queue:work --queue=mail\n```\n\n**201** `{ message, data }`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"A comment posted from Postman.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setVar = (k, v) => { pm.collectionVariables.set(k, v); try { pm.environment.set(k, v); } catch (e) {} };",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "if (b.data && b.data.id) { setVar('comment_id', b.data.id); }"
                ]
              }
            }
          ]
